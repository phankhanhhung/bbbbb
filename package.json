{
  "name": "combviz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "index": "tsx tools/pipeline/src/cli.ts index",
    "prepare": "pnpm index",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx tools/pipeline/src/cli.ts validate packages/content",
    "check": "pnpm index && pnpm typecheck && pnpm lint && pnpm test && pnpm validate",
    "e2e": "playwright test --project=desktop --project=ipad",
    "e2e:perf": "playwright test --project=perf --workers=1",
    "coverage": "tsx tools/pipeline/src/cli.ts coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "playwright": "^1.62.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
