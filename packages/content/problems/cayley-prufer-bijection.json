  "id": "cayley-prufer-bijection",
  "statement": {
    "vi": "Có bao nhiêu **cây có nhãn** trên $n$ đỉnh $1, 2, \\dots, n$? Chứng minh rằng số ấy bằng $n^{n-2}$ (công thức Cayley)."
  },
  "source": {
    "contest": "folklore",
    "note": {
      "vi": "Chứng minh bằng mã Prüfer: song ánh giữa cây có nhãn và dãy độ dài n−2 trên bảng chữ cái n nhãn."
    }
  },
  "topics": [
    "graph-basics",
    "counting"
  ],
  "techniques": [
    "bijection"
  ],
  "difficulty": {
