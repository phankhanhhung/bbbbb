              ]
            },
            "elements": []
          },
          "alt_text": {
            "vi": "Hai dòng: (a cộng b) bình phương, rồi a bình cộng 2ab cộng b bình, tô hai màu theo vai."
          },
          "verified": true
        },
        {
          "id": "s1",
          "parent": "s0",
          "edge_type": "seq",
          "narrative": {
            "vi": "Cùng cái khuôn ấy lên bậc ba. Số lần mỗi vai xuất hiện tăng lên, nhưng [[a1|cách đọc]] không đổi: đếm màu là đếm được hệ số $1, 3, 3, 1$."
          },
          "anchors": {
            "a1": {
              "ids": [
                "row1"
              ]
            }
          },
          "scene": {
            "engine": "algebra",
            "config": {
