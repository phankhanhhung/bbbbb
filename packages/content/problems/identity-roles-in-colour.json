          "edge_type": "seq",
          "narrative": {
            "vi": "Vai $a$ một màu, vai $b$ một màu. [[a1|Dòng dưới]] cho thấy $a$ xuất hiện ba lần và $b$ ba lần — đúng số lần cái khuôn đòi. Sợi nối chỉ ra bản nào của $a$ đi từ đâu xuống đâu."
          },
          "anchors": {
            "a1": {
              "ids": [
                "row1"
              ]
            }
          },
          "scene": {
            "engine": "algebra",
            "config": {
              "start": "(a + b)^2",
              "steps": [
