    {
      "id": "sol",
      "label": {
        "vi": "Đoán một nghiệm rồi hạ bậc"
      },
      "steps": [
        {
          "id": "s0",
          "parent": null,
          "edge_type": "seq",
          "narrative": {
            "vi": "Thử $x = 1$: thay vào được $1 - 3 + 2$, tức [[a1|đúng bằng $0$]]. Vậy $x=1$ là nghiệm, và theo định lý Bézout thì $(x-1)$ là một nhân tử. Đây là toàn bộ chỗ cần \"đoán\" — phần còn lại là tính."
          },
          "anchors": {
            "a1": {
              "ids": [
                "row2"
              ]
            }
          },
          "scene": {
            "engine": "algebra",
            "config": {
              "start": "x^3 - 3*x + 2",
              "steps": [
                {
                  "arg": "x := 1",
                  "at": "",
                  "rule": "evaluate_at"
                },
                {
                  "at": "",
                  "rule": "eval_int"
                }
              ]
            },
            "elements": []
          },
          "alt_text": {
            "vi": "Ba dòng: x lập phương trừ 3x cộng 2, thay x bằng 1, rồi bằng 0."
          },
          "verified": true
        },
        {
          "id": "s1",
          "parent": "s0",
          "edge_type": "seq",
          "narrative": {
            "vi": "Biết nhân tử rồi thì chia. Engine chạy sơ đồ Horner và [[a1|tính ra thương]] — tác giả chỉ khai chia cho cái gì. Bậc ba vừa tụt xuống bậc hai mà không cần rời khỏi chuỗi biến đổi."
          },
          "anchors": {
            "a1": {
              "ids": [
                "row1"
              ]
            }
          },
          "scene": {
            "engine": "algebra",
            "config": {
              "start": "x^3 - 3*x + 2",
              "steps": [
                {
                  "arg": "x - 1",
                  "at": "",
                  "rule": "divide_by_linear_factor"
                }
              ]
            },
            "elements": []
          },
          "alt_text": {
            "vi": "Hai dòng: đa thức bậc ba, rồi (x trừ 1) nhân (x bình cộng x trừ 2)."
          },
          "verified": true
        },
        {
          "id": "s2",
          "parent": "s1",
          "edge_type": "seq",
          "narrative": {
            "vi": "Thương là tam thức bậc hai, và nó phân tích được bằng số nguyên. [[a1|Kết quả]] cho thấy $x=1$ là nghiệm **kép** — điều mà chỉ nhìn đa thức ban đầu thì không đoán ra."
          },
          "anchors": {
            "a1": {
              "ids": [
                "row2"
              ]
            }
          },
          "scene": {
            "engine": "algebra",
            "config": {
              "start": "x^3 - 3*x + 2",
              "steps": [
                {
                  "arg": "x - 1",
                  "at": "",
                  "rule": "divide_by_linear_factor"
                },
                {
                  "at": "1",
                  "rule": "factor_quadratic"
                }
              ]
            },
            "elements": []
          },
          "alt_text": {
            "vi": "Ba dòng, kết thúc ở (x trừ 1)(x trừ 1)(x cộng 2)."
          },
          "verified": true
        },
        {
          "id": "end",
          "parent": "s2",
          "edge_type": "seq",
          "narrative": {
            "vi": "Đoán sai thì sao? Chia cho $(x-3)$ thì engine [[a1|từ chối và nói số dư]]: $20 \\ne 0$. Lời từ chối ấy chính là câu trả lời cho câu hỏi \"$(x-3)$ có phải nhân tử không\" — nên bước hỏng vẫn dạy được một điều."
          },
