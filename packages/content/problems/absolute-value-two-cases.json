      "steps": [
        {
          "id": "s0",
          "parent": null,
          "edge_type": "seq",
          "narrative": {
            "vi": "Dấu giá trị tuyệt đối không bỏ được nếu chưa biết dấu của biểu thức bên trong. Nên bài tách làm hai nhánh, và [[a1|dòng đỏ]] dưới mỗi hình ghi rõ nhánh ấy chỉ có nghĩa ở đâu. Chia nhánh là việc của cây lời giải, không phải của một nút trong biểu thức."
          },
          "anchors": {
            "a1": {
              "ids": [
                "row1"
              ]
            }
          },
          "scene": {
            "engine": "algebra",
            "config": {
              "start": "abs(x - 2) = 3*x",
              "steps": [
                {
                  "arg": "+",
                  "at": "L",
                  "rule": "abs_case"
                }
              ]
            },
            "elements": []
          },
          "alt_text": {
            "vi": "Hai dòng: trị tuyệt đối của x trừ 2 bằng 3x, rồi x trừ 2 bằng 3x, kèm điều kiện x trừ 2 lớn hơn hoặc bằng 0."
          },
          "verified": true
        },
        {
          "id": "c1",
          "parent": "s0",
          "edge_type": "case",
          "case_label": {
            "vi": "Trường hợp 1: x − 2 ≥ 0"
          },
          "narrative": {
            "vi": "Nhánh này giả thiết $x \\ge 2$. Chuyển vế và thu gọn được [[a1|$-2x = 2$]], tức $x = -1$. Nhưng $-1 < 2$ nên nó **vi phạm chính điều kiện của nhánh** — loại, dù nó là nghiệm đúng của phương trình đã bỏ dấu."
          },
          "anchors": {
            "a1": {
              "ids": [
                "row4"
              ]
            }
          },
          "scene": {
            "engine": "algebra",
            "config": {
              "start": "abs(x - 2) = 3*x",
              "steps": [
                {
                  "arg": "+",
                  "at": "L",
                  "rule": "abs_case"
                },
                {
                  "arg": "-3*x + 2",
                  "at": "",
                  "rule": "add_both_sides"
                },
                {
                  "at": "L",
                  "rule": "collect_like"
                },
                {
                  "at": "R",
                  "rule": "collect_like"
                }
              ]
            },
            "elements": []
          },
          "alt_text": {
            "vi": "Năm dòng nhánh dương, kết thúc ở âm 2x bằng 2 với điều kiện x trừ 2 không âm."
          },
          "verified": true
        },
        {
          "id": "c2",
          "parent": "s0",
          "edge_type": "case",
          "case_label": {
            "vi": "Trường hợp 2: x − 2 ≤ 0"
          },
          "narrative": {
            "vi": "Nhánh kia giả thiết $x \\le 2$, và dấu trừ được phân phối vào trong ngoặc. Thu gọn cho [[a1|$2 = 4x$]], tức $x = \\frac12$. Lần này $\\frac12 \\le 2$ nên điều kiện thoả — đây là nghiệm duy nhất của bài."
          },
