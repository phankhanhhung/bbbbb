            "a1": {
              "ids": [
                "row6"
              ]
            }
          },
          "scene": {
            "engine": "algebra",
            "config": {
              "start": "sqrt(x + 5) = x - 1",
              "steps": [
                {
                  "arg": "2",
                  "at": "",
                  "note": "bình phương hai vế",
                  "rule": "pow_both_sides"
                },
                {
                  "at": "L",
                  "rule": "root_pow"
                },
                {
                  "at": "R",
                  "rule": "multiply_out"
                },
                {
                  "arg": "-x - 5",
                  "at": "",
                  "rule": "add_both_sides"
                },
                {
                  "at": "L",
                  "rule": "collect_like"
                },
                {
                  "at": "R",
                  "rule": "collect_like"
                }
              ]
            },
            "elements": []
          },
          "alt_text": {
            "vi": "Bảy dòng: phương trình chứa căn được bình phương hai vế rồi thu gọn thành x bình trừ 3x trừ 4 bằng 0."
          },
          "verified": true
        },
        {
          "id": "c1",
          "parent": "s0",
          "edge_type": "case",
          "case_label": {
            "vi": "Trường hợp 1: thử x = 4"
