{
  "schema_version": "1.2.0",
  "id": "sign-flip-4x4",
  "statement": {
    "vi": "Bảng $4\\times4$ ghi số $1$ ở mọi ô, trừ đúng một ô ghi $-1$. Mỗi bước được đổi dấu toàn bộ một hàng hoặc một cột. Chứng minh không bao giờ đưa được bảng về toàn số $1$."
  },
  "source": {
    "contest": "folklore",
    "note": {
      "vi": "Bài dân gian; dạng bất biến kinh điển cho thao tác lặp."
    }
  },
  "topics": [
    "sequences",
    "coloring"
  ],
  "techniques": [
    "invariant",
    "parity"
  ],
  "difficulty": {
