        "vi": "Hai chiều, hai hình dạng"
      },
      "steps": [
        {
          "id": "s0",
          "parent": null,
          "edge_type": "seq",
          "narrative": {
            "vi": "\"Khoảng cách tới $1$ nhỏ hơn $3$\" nghĩa là [[a1|bị kẹp giữa]] — cả hai điều kiện phải cùng đúng, nên nó là một hội và vẽ trong ngoặc nhọn."
          },
          "anchors": {
            "a1": {
              "ids": [
                "row1"
              ]
            }
          },
          "scene": {
            "engine": "algebra",
            "config": {
              "start": "abs(x - 1) < 3",
              "steps": [
                {
                  "at": "",
                  "rule": "abs_to_interval"
                }
              ]
            },
            "elements": []
          },
          "alt_text": {
            "vi": "Hai dòng: trị tuyệt đối x trừ 1 nhỏ hơn 3, rồi hệ hai bất đẳng thức."
          },
          "verified": true
        },
        {
          "id": "s1",
          "parent": "s0",
          "edge_type": "seq",
          "narrative": {
            "vi": "Còn \"khoảng cách lớn hơn $3$\" thì [[a1|hai phía đều được]], miễn một trong hai đúng — một tuyển, và engine vẽ nó nằm ngang nối bằng chữ \"hoặc\"."
          },
          "anchors": {
            "a1": {
              "ids": [
                "row1"
              ]
            }
          },
          "scene": {
            "engine": "algebra",
            "config": {
              "start": "abs(x - 1) > 3",
              "steps": [
                {
                  "at": "",
                  "rule": "abs_to_interval"
                }
              ]
            },
            "elements": []
          },
          "alt_text": {
            "vi": "Hai dòng: trị tuyệt đối x trừ 1 lớn hơn 3, rồi x trừ 1 nhỏ hơn âm 3 hoặc x trừ 1 lớn hơn 3."
          },
          "verified": true
        },
        {
          "id": "s2",
          "parent": "s1",
          "edge_type": "seq",
          "narrative": {
            "vi": "Và hai ràng buộc cùng chiều thì [[a1|gộp lại được]]: trong một hội, cái chặt hơn thắng — $x>1$ đứng cạnh $x>2$ thì chỉ $x>2$ còn nói điều gì."
          },
          "anchors": {
            "a1": {
              "ids": [
                "row1"
              ]
            }
          },
          "scene": {
            "engine": "algebra",
            "config": {
