                "count": 3
              }
            ]
          },
          "alt_text": {
            "vi": "Cùng ba đống, nhưng dưới đống ba viên ghi g bằng bốn."
          },
          "claims": [
            "xor == 7",
            "winning == true",
            "winning_moves == 1"
          ],
          "expects_violation": [
            "hand-opponent-a-loss"
          ],
          "verified": true
        },
        {
          "id": "s2",
          "parent": "s1",
          "edge_type": "seq",
          "narrative": {
            "vi": "Có đúng ${{winning_moves}}$ nước thắng, và nó **là** một nước chia: tách đống $3$ thành [[a3|$1$ và $2$]]. Thế sau đó gồm bốn đống $1, 2, 1, 2$ với Grundy $1, 2, 1, 2$, nên XOR về ${{xor}}$. Bốc thì không nước nào đạt được điều đó: muốn XOR về $0$ phải đổi $g$ của một đống thành $3$, mà $g$ chỉ nhận $3$ ở đống $4$ viên — lớn hơn mọi đống đang có."
          },
