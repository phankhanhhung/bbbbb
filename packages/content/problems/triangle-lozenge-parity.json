{
  "schema_version": "1.7.0",
  "id": "triangle-lozenge-parity",
  "statement": {
    "vi": "Tam giác đều cạnh $n$ được chia thành $n^2$ tam giác đơn vị bởi các đường song song với ba cạnh. Một **hình thoi** là hình ghép từ hai tam giác đơn vị chung cạnh. Chứng minh rằng với mọi $n \\ge 1$, không thể lát kín tam giác ấy bằng các hình thoi."
  },
  "source": {
    "contest": "folklore",
    "note": {
      "vi": "Bài lát hình kinh điển trên lưới tam giác; lời giải là một phép đếm hai màu."
    }
  },
  "topics": [
    "tiling"
  ],
  "techniques": [
    "invariant",
    "parity"
  ],
  "difficulty": {
    "author_rating": 2,
    "slot_proxy": "P1"
  },
  "engines_used": [
    "board"
  ],
  "license": "CC-BY-SA-4.0",
  "authors": [
    "draft-may"
  ],
  "status": "published",
  "kind": "both",
  "created": "2026-07-30",
  "updated": "2026-07-30",
  "invariants": [
    {
      "expr": "count(cells, c => c.color_class == 1) - count(cells, c => c.color_class == 2)",
      "id": "inv-d",
      "label": {
        "vi": "Số ô lên trừ số ô xuống"
      }
    },
    {
      "expr": "sum(tiles, t => t.size)",
      "id": "inv-c",
      "label": {
        "vi": "Số ô đã phủ"
      }
    },
    {
      "expr": "count(cells, c => !covered(c))",
      "id": "inv-con-trong",
      "label": {
        "vi": "Số ô còn trống"
      }
    }
  ],
  "solutions": [
