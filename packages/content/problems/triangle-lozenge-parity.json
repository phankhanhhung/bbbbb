        "vi": "Lời giải"
      },
      "steps": [
        {
          "id": "s0",
          "parent": null,
          "edge_type": "seq",
          "narrative": {
            "vi": "Tam giác đều cạnh $n = 5$ chia thành ${{count(cells)}}$ tam giác đơn vị: hàng $r$ có $2r+1$ ô, mà $1+3+5+7+9 = 25 = n^2$. Nhìn kỹ thì [[a1|các ô]] có **hai kiểu**: ô hướng lên và ô hướng xuống, và một hình thoi luôn gồm **một ô mỗi kiểu** — vì hai tam giác chung cạnh thì bắt buộc ngược chiều nhau."
          },
          "anchors": {
            "a1": {
              "ids": [
                "cell-0-0",
                "cell-4-0",
                "cell-4-1"
              ]
            }
          },
          "scene": {
            "engine": "board",
            "config": {
              "cols": 5,
              "lattice": "triangle",
              "rows": 5
            },
            "elements": []
          },
          "alt_text": {
            "vi": "Tam giác đều chia thành hai mươi lăm tam giác đơn vị, chưa tô màu."
          },
          "claims": [
            "count(cells) == 25",
            "rows == 5"
          ],
          "expects_violation": [
            "full-cover"
          ],
          "verified": true
        },
        {
          "id": "s1",
          "parent": "s0",
          "edge_type": "seq",
          "narrative": {
            "vi": "Tô theo chiều: [[a2|ô hướng lên]] một màu, ô hướng xuống màu kia. Đếm ra ${{count(cells, c => c.color_class == 1)}}$ ô hướng lên và ${{count(cells, c => c.color_class == 2)}}$ ô hướng xuống — hàng $r$ có $r+1$ ô lên và $r$ ô xuống, nên tổng là $\\frac{n(n+1)}{2}$ và $\\frac{n(n-1)}{2}$. **Hiệu đúng bằng $n$**, và đó là toàn bộ lời giải."
          },
          "anchors": {
            "a2": {
              "ids": [
                "cell-0-0",
                "cell-1-0",
                "cell-1-2",
                "cell-2-0",
                "cell-2-2",
                "cell-2-4"
              ]
            }
          },
          "scene": {
            "engine": "board",
            "config": {
              "coloring_preset": {
                "type": "checkerboard"
              },
              "cols": 5,
              "lattice": "triangle",
              "rows": 5
            },
            "elements": []
          },
          "alt_text": {
            "vi": "Cùng tam giác ấy, ô hướng lên tô đậm và ô hướng xuống tô nhạt."
          },
          "claims": [
            "count(cells, c => c.color_class == 1) == 15",
            "count(cells, c => c.color_class == 2) == 10"
          ],
          "expects_violation": [
            "full-cover"
          ],
          "verified": true
        },
