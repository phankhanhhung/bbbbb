      "steps": [
        {
          "id": "s0",
          "parent": null,
          "edge_type": "seq",
          "narrative": {
            "vi": "Nhân bừa bốn nhân tử ra thì được đa thức bậc bốn, và bậc bốn thì không có công thức nào để dùng. Mẹo là ghép **cặp có tổng bằng nhau**: $(x+1)(x+4)$ và $(x+2)(x+3)$ đều cho $x^2+5x$ rồi cộng thêm $4$ và $6$. Đặt $t = x^2+5x$ thì cả bài co lại thành [[a1|một phương trình bậc hai]]."
          },
