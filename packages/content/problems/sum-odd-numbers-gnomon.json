  "schema_version": "1.3.0",
  "id": "sum-odd-numbers-gnomon",
  "statement": {
    "vi": "Chứng minh rằng tổng $n$ số lẻ đầu tiên bằng $n^2$, bằng cách xếp hình."
  },
  "source": {
    "contest": "folklore",
    "note": {
      "vi": "Gnomon — lớp chữ L. Đây là chứng minh không lời cổ điển, và cái nó dạy là \"đổi cách nhìn một tổng thành một hình\"."
    }
  },
  "topics": [
    "counting"
  ],
