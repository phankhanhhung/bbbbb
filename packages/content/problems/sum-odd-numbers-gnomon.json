          "narrative": {
            "vi": "Cộng các số lẻ: $1 + 3 + 5 + \\dots + 9$. Xếp chúng thành những lớp chữ L lồng nhau — [[a1|lớp trong cùng]] một ô, lớp sau ba ô, rồi năm ô."
          },
          "anchors": {
            "a1": {
              "ids": [
                "cell-0-0"
              ]
            }
          },
          "scene": {
            "engine": "board",
