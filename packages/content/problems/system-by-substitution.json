          "parent": null,
          "edge_type": "seq",
          "narrative": {
            "vi": "Phương trình đầu đã cô lập $x$. Thế nó vào phương trình thứ hai thì [[a1|chỉ còn một ẩn]] — và từ đó là chuyện của một phương trình bậc nhất bình thường."
          },
          "anchors": {
            "a1": {
              "ids": [
                "row3"
              ]
            }
          },
          "scene": {
            "engine": "algebra",
            "config": {
              "start": "x = 5 - 2*y; 3*x - y = 1",
              "steps": [
                {
                  "arg": "0,1",
                  "at": "",
                  "rule": "substitute_from"
                },
                {
                  "at": "1.L.0",
                  "rule": "distribute"
                },
                {
                  "at": "1.L",
                  "rule": "collect_like"
                }
              ]
            },
            "elements": []
          },
          "alt_text": {
            "vi": "Bốn hệ: hàng dưới rút dần từ ba nhân năm trừ hai y trừ y, tới còn một ẩn."
          },
          "verified": true
        },
        {
          "id": "s1",
          "parent": "s0",
          "edge_type": "seq",
          "narrative": {
            "vi": "Còn khi một phương trình đã rút về hai vế **giống hệt nhau** — ở đây $x + y = x + y$ — thì nó [[a1|không nói gì nữa]] và bỏ đi được. Engine chỉ cho bỏ khi hai vế thật sự trùng nhau từng nút: bỏ một phương trình còn nội dung là mất nghiệm."
          },
