  "id": "pascal-identity-two-ways",
  "statement": {
    "vi": "Chứng minh hệ thức Pascal $\\binom{n}{k} = \\binom{n-1}{k-1} + \\binom{n-1}{k}$ bằng lập luận đếm, không dùng công thức giai thừa."
  },
  "source": {
    "contest": "folklore",
    "note": {
      "vi": "Đếm hai chiều kinh điển; đối tượng của lập luận là chính đồng nhất thức."
    }
  },
  "topics": [
    "counting"
  ],
  "techniques": [
    "bijection",
    "double-counting"
  ],
