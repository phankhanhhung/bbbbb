          "id": "s1",
          "parent": "s0",
          "edge_type": "seq",
          "narrative": {
            "vi": "Giờ đi lại bằng cỗ máy, vì cỗ máy còn chạy được khi phép đếm tay hết đường. Một phần cỡ $\\ge 1$ là $x + x^2 + \\cdots = \\frac{x}{1-x}$; nhiều phần nối nhau cho $\\sum_{k\\ge1}\\left(\\frac{x}{1-x}\\right)^k$, cộng lại đúng bằng [[a1|$\\frac{x}{1-2x}$]]. Hệ số dẫn $2$ ở mẫu là hai lựa chọn ở mỗi khe — cùng một sự thật, viết bằng đại số."
          },
          "anchors": {
            "a1": {
              "ids": [
                "row0"
              ]
            }
          },
          "scene": {
            "engine": "algebra",
            "config": {
              "caption": "mở lại 1/(1 − 2x) thành chuỗi",
              "start": "1/(1-2*x)",
              "steps": [
                {
                  "at": "",
                  "rule": "geometric_series"
